<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.ModelTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mitra.app.debug.MODEL_TEST" />
                <action android:name="com.mitra.app.foss.debug.MODEL_TEST" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.ScreenDumpReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mitra.app.debug.DUMP_SCREEN" />
                <action android:name="com.mitra.app.foss.debug.DUMP_SCREEN" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.DebugActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mitra.app.debug.ACTION" />
                <action android:name="com.mitra.app.foss.debug.ACTION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
